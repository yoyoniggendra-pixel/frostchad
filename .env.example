# Render/backend settings
PORT=3000
ROOM_NAME=FROSTLINK
MAX_UPLOAD_MB=100
MAX_HISTORY=500
CORS_ORIGIN=https://YOUR-FROSTLINK.vercel.app

# Supabase - keep the service-role key ONLY on the backend
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_BUCKET=frostlink-uploads

# Long random secret used to sign Frostlink login sessions
AUTH_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional GIPHY key - keep server-side
GIPHY_API_KEY=YOUR_GIPHY_KEY
GIPHY_RATING=pg-13
